{
  "name": "pi-anthropic-compat",
  "version": "0.0.4",
  "description": "Native Anthropic compaction compatibility for Pi",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/2h2d-co/pi-anthropic-compat#readme",
  "bugs": {
    "url": "https://github.com/2h2d-co/pi-anthropic-compat/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Kaan Ozdokmeci",
    "email": "kaan@2h2d.co",
    "url": "https://www.2h2d.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2h2d-co/pi-anthropic-compat.git"
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "check": "hk check --all --check",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:live": "PI_ANTHROPIC_LIVE_TEST=1 node --test --test-concurrency=1 test/live.test.ts test/cli.live.test.ts",
    "pack:dry": "npm pack --dry-run --ignore-scripts --allow-directory=all",
    "release": "node scripts/release.ts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@2h2d/oxlint-config": "0.1.1",
    "@2h2d/ts-config": "0.0.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "22.20.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.87.0",
    "@earendil-works/pi-coding-agent": ">=0.87.0",
    "@earendil-works/pi-tui": ">=0.87.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}
